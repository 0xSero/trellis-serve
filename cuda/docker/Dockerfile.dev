# sglang-exl3 dev image for Ampere (sm_86): stock SGLang + ExLlamaV3 kernels built for 8.6 + this package.
# Build from the repo root:  docker build -f cuda/docker/Dockerfile.dev -t sglang-exl3:dev .
ARG BASE=lmsysorg/sglang:v0.5.20
FROM ${BASE}
ARG EXLLAMAV3_TAG=v1.5.1
ARG TORCH_CUDA_ARCH_LIST=8.6
ENV TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST}
RUN apt-get update && apt-get install -y --no-install-recommends git ninja-build && rm -rf /var/lib/apt/lists/*
# ExLlamaV3 extension only (no tokenizers/llguidance pulled in); built AOT for sm_86 against the image's torch.
RUN git clone --depth 1 --branch ${EXLLAMAV3_TAG} https://github.com/turboderp-org/exllamav3 /opt/exllamav3-src \
 && cd /opt/exllamav3-src \
 && MAX_JOBS=32 pip install --no-build-isolation --no-deps -v . 2>&1 | tail -5 \
 && pip install --no-deps safetensors "numpy" "pillow" "rich" "tokenizers" "regex" "marisa-trie" 2>/dev/null || true
COPY core /opt/trellis-serve/core
COPY cuda /opt/trellis-serve/cuda
RUN pip install --no-deps -e /opt/trellis-serve/core && pip install --no-deps -e /opt/trellis-serve/cuda
ENV SGLANG_EXL3=1
